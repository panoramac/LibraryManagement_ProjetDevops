pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {

        /********************* 🧱 1. BUILD MAVEN *********************/
        stage('Build Project') {
            steps {
                git branch: 'feature/docker',
                    url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'Library-management/Back-End/**/target/*.jar', fingerprint: true
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo '✅ Build Maven successful'
                }
            }
        }

        /********************* 🐳 2. BUILD DES IMAGES DOCKER *********************/
        stage('Build Docker Images') {
            steps {
                script {
                    // Build backend
                    dir('Library-management/Back-End') {
                        bat """
                        echo "Building backend image..."
                        docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} .
                        echo "✅ Backend image built successfully"
                        """
                    }

                    // Build frontend
                    dir('Library-management/Front-End') {
                        bat """
                        echo "Building frontend image..."
                        docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} .
                        echo "✅ Frontend image built successfully"
                        """
                    }

                    // Lister les images construites
                    bat 'docker images | findstr "library" || echo "⚠️ Aucune image trouvée"'
                }
            }
        }

        /********************* ☁️ 3. PUSH VERS DOCKER HUB *********************/
        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        echo "✅ Images pushed to Docker Hub"
                        """
                    }
                }
            }
        }

        /********************* 🧪 4. TEST AVEC CONTENEURS *********************/
        stage('Run Containers for Test') {
            steps {
                script {
                    bat """
                    echo "Cleaning old containers..."
                    docker rm -f test-backend || echo "No backend container to remove"
                    docker rm -f test-frontend || echo "No frontend container to remove"

                    docker network create app-network || echo "network already exists"

                    echo "Starting new containers..."
                    docker run -d --name test-backend --network app-network -p 9091:9090 ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                    docker run -d --name test-frontend --network app-network -p 80:80 ${IMAGE_NAME_FRONT}:${IMAGE_TAG}



                    echo "Containers status:"
                    docker ps
                    """

                    // Health checks
                    bat """
                    echo "Testing containers health..."
                    curl -f http://localhost:9090/livres|| (echo "❌ Backend failed!" & exit /b 1)
                    curl -f http://localhost:80/ || (echo "❌ Frontend failed!" & exit /b 1)
                    echo "✅ Containers are running and reachable!"
                    """
                }
            }

        }
    }

    /********************* 🏁 POST-BUILD *********************/
    post {
        always {
            echo "Build finished: ${currentBuild.currentResult}"
            echo "Build URL: ${env.BUILD_URL}"
        }
        success {
            echo '✅ SUCCESS! CI/CD Pipeline working perfectly!'
            echo "Published images:"
            echo "   - ${IMAGE_NAME_BACK}:${IMAGE_TAG}"
            echo "   - ${IMAGE_NAME_FRONT}:${IMAGE_TAG}"
        }
        failure {
            echo '❌ Pipeline failed. Check Jenkins logs for details.'
        }
    }
}
