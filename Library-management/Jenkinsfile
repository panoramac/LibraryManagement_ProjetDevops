pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    stages {
        stage('Build Project') {
            steps {
                git branch: 'feature/pipeline-jenkins',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    // 🎯 ARCHIVE LE .jar (votre projet Spring Boot génère un JAR)
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'

                    // 🎯 PUBLIE LES RAPPORTS DE TESTS
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'

                    echo '🎉 🎉🎉 FÉLICITATIONS ! PIPELINE CI/CD OPÉRATIONNEL ! 🎉🎉🎉'
                }
            }
        }
    }

    post {
        always {
            echo "Build terminé : ${currentBuild.currentResult}"
            echo "URL du build : ${env.BUILD_URL}"
            echo "Consultez les artefacts archivés !"
        }
        success {
            echo '✅ ✅✅ SUCCÈS TOTAL ! VOTRE PREMIER PIPELINE JENKINS FONCTIONNE ! ✅✅✅'
            echo '📦 Artefact généré : Users-0.0.1-SNAPSHOT.jar'
            echo '🧪 Rapports de tests : surefire-reports/'
        }
    }
}