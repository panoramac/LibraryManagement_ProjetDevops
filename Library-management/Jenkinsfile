pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    stages {
        stage('Build with Encoding Fix') {
            steps {
                git branch: 'feature/pipeline-jenkins',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    // 🎯 FORCER l'encodage Windows-1252 pour Maven
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=windows-1252 -Dproject.build.resourceEncoding=windows-1252'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    archiveArtifacts 'Library-management/Back-End/**/target/*.war'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo '🎉 🎉🎉 FÉLICITATIONS ! PIPELINE CI/CD OPÉRATIONNEL ! 🎉🎉🎉'
                }
            }
        }
    }
}