pipeline {
    agent any
    stages {
        stage('Test SonarCloud Config') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    bat '''
                        echo "✅ SonarCloud configuré avec succès!"
                        echo "URL: %SONAR_HOST_URL%"
                    '''
                }
            }
        }
    }
}