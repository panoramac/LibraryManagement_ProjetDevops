stage('Run Containers for Test') {
    steps {
        script {
            bat '''
            docker stop test-backend test-frontend 2>nul || echo No test containers to stop
            docker rm test-backend test-frontend 2>nul || echo No test containers to remove
            '''

            // Ports alternatifs si 80 est occupé
            bat """
            docker run -d -p 9091:9090 --name test-backend ${IMAGE_NAME_BACK}:${IMAGE_TAG}
            docker run -d -p 8080:80 --name test-frontend ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
            timeout /t 10
            echo "Containers status:"
            docker ps
            """

            bat """
            echo "Testing containers..."
            curl -f http://localhost:9091/actuator/health || echo "Backend health check failed"
            curl -f http://localhost:8080/ || echo "Frontend check failed"
            """

            bat """
            docker stop test-backend test-frontend
            docker rm test-backend test-frontend
            echo "Test completed"
            """
        }
    }
}