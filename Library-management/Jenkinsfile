pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {
        /********************* 🧱 1. BUILD MAVEN *********************/
        stage('Build Project') {
            steps {
                git branch: 'feature/pipeline-jenkins',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo '🎉 🎉🎉 FÉLICITATIONS ! PIPELINE CI/CD OPÉRATIONNEL ! 🎉🎉🎉'
                }
            }
        }

        /********************* 🐳 2. BUILD DES IMAGES DOCKER CORRIGÉ *********************/
        stage('Build Docker Images') {
            steps {
                script {
                    // Les Dockerfiles sont dans Library-management/Back-End/ et Library-management/Front-End/
                    dir('Library-management/Back-End') {
                        bat "docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} ."
                    }
                    dir('Library-management/Front-End') {
                        bat "docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} ."
                    }
                }
            }
        }

        /********************* ☁️ 3. PUSH VERS DOCKER HUB *********************/
        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        """
                    }
                }
            }
        }

        /********************* 🧪 4. TEST VIA DOCKER COMPOSE *********************/
        stage('Run Containers for Test') {
            steps {
                script {
                    dir('Library-management') {
                        bat """
                        docker compose up -d
                        timeout /t 30
                        docker ps
                        docker compose down
                        """
                    }
                }
            }
        }
    }

    /********************* 🏁 POST-BUILD *********************/
    post {
        always {
            echo "Build terminé : ${currentBuild.currentResult}"
            echo "URL du build : ${env.BUILD_URL}"
            echo "Consultez les artefacts archivés !"
        }
        success {
            echo '✅ ✅✅ SUCCÈS TOTAL ! VOTRE PIPELINE CI/CD FONCTIONNE PARFAITEMENT ! ✅✅✅'
            echo "📦 Images publiées :"
            echo "   - ${IMAGE_NAME_BACK}:${IMAGE_TAG}"
            echo "   - ${IMAGE_NAME_FRONT}:${IMAGE_TAG}"
        }
        failure {
            echo '❌ Le pipeline a échoué. Consultez les logs Jenkins pour plus de détails.'
        }
    }
}