pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {
        stage('Build Project') {
            steps {
                git branch: 'feature/docker',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo 'Build Maven successful'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    // Nettoyage des containers existants (sans caractères spéciaux)
                    bat 'docker stop library-backend library-frontend 2>nul || echo No containers to stop'
                    bat 'docker rm library-backend library-frontend 2>nul || echo No containers to remove'

                    dir('Library-management/Back-End') {
                        bat "docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} ."
                    }
                    dir('Library-management/Front-End') {
                        bat "docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} ."
                    }
                }
            }
        }

        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        """
                    }
                }
            }
        }

        stage('Run Containers for Test') {
            steps {
                script {
                    bat 'docker stop library-backend-test library-frontend-test 2>nul || echo No test containers to stop'
                    bat 'docker rm library-backend-test library-frontend-test 2>nul || echo No test containers to remove'

                    bat """
                    docker run -d -p 9090:9090 --name library-backend-test ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                    docker run -d -p 8080:80 --name library-frontend-test ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                    timeout /t 10
                    docker ps
                    """

                    // Nettoyage après test
                    bat """
                    docker stop library-backend-test library-frontend-test
                    docker rm library-backend-test library-frontend-test
                    """
                }
            }
        }
    }

    post {
        always {
            echo "Build finished: ${currentBuild.currentResult}"
        }
        success {
            echo 'SUCCESS! Pipeline CI/CD working perfectly!'
        }
        failure {
            echo 'Pipeline failed. Check Jenkins logs for details.'
        }
    }
}