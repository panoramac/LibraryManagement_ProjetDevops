pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        // Variables d'application
        APP_NAME_BACK = "library-backend"
        APP_NAME_FRONT = "library-frontend"
        IMAGE_TAG = "v1"

        // Variables SonarCloud - DÉFINIES DIRECTEMENT
        SONAR_ORGANIZATION = "panoramac"
        SONAR_PROJECT_KEY = "panoramac_LibraryManagement_ProjetDevops"
    }

    stages {
        /********************* 🔍 1. MISE À JOUR DU POM.XML *********************/
        stage('Update POM with Sonar Properties') {
            steps {
                dir('Library-management/Back-End') {
                    script {
                        // Vérifier si le POM a déjà la configuration Sonar
                        bat """
                        echo "📄 Vérification du fichier POM.xml..."
                        findstr "sonar.organization" pom.xml || (
                            echo "⚠️  Configuration Sonar manquante dans POM, utilisation des paramètres en ligne de commande"
                        )
                        """
                    }
                }
            }
        }

        /********************* 🔍 2. ANALYSE SONARCLOUD AVEC NOUVEAU TOKEN *********************/
        stage('SonarCloud Analysis') {
            steps {
                dir('Library-management/Back-End') {
                    script {
                        // ✅ UTILISATION DU NOUVEAU TOKEN
                        withCredentials([string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')]) {
                            bat """
                            echo "🚀 Démarrage analyse SonarCloud..."
                            echo "Organisation: ${SONAR_ORGANIZATION}"
                            echo "Project Key: ${SONAR_PROJECT_KEY}"
                            echo "Token: ${SONAR_TOKEN}"

                            # Commande EXACTE recommandée par SonarCloud
                            mvn verify sonar:sonar \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.organization=${SONAR_ORGANIZATION} \
                                -Dsonar.host.url=https://sonarcloud.io \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.sources=src/main/java \
                                -Dsonar.java.binaries=target/classes \
                                -Dsonar.sourceEncoding=UTF-8
                            """
                        }
                    }
                }
            }
        }

        /********************* ⏳ 3. QUALITY GATE *********************/
        stage("Quality Gate") {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /********************* 🧱 4. BUILD & TESTS *********************/
        stage('Build & Unit Tests') {
            steps {
                git branch: 'develop',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo '✅ Build Maven et tests unitaires réussis'
                }
            }
        }

        // ... [Les autres stages Docker restent IDENTIQUES]
    }

    post {
        always {
            echo "Build finished: ${currentBuild.currentResult}"
        }
        success {
            echo '🎉 Pipeline CI/CD réussi!'
        }
    }
}