pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        // Configuration des images Docker
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1-${env.BUILD_ID}"

        // Ports de test
        BACKEND_TEST_PORT = "9091"
        FRONTEND_TEST_PORT = "8080"
    }

    stages {
        /******************************************************************
         * 1. RÉCUPÉRATION ET BUILD DU PROJET
         *****************************************************************/
        stage('📥 Checkout and Build') {
            steps {
                script {
                    echo "🔧 Étape 1: Récupération du code et build Maven"

                    // Checkout du code source
                    git branch: 'feature/docker',
                    url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                    // Build Maven avec gestion d'erreur
                    dir('Library-management/Back-End') {
                        bat """
                        echo "Building Java application..."
                        mvn clean compile test package -Dproject.build.sourceEncoding=UTF-8
                        """
                    }
                }
            }
            post {
                success {
                    echo "✅ Build Maven réussi"
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                }
                failure {
                    echo "❌ Échec du build Maven"
                    error "Le build Maven a échoué - Vérifiez le code source"
                }
            }
        }

        /******************************************************************
         * 2. CONSTRUCTION DES IMAGES DOCKER
         *****************************************************************/
        stage('🐳 Build Docker Images') {
            steps {
                script {
                    echo "🔧 Étape 2: Construction des images Docker"

                    // Build de l'image backend
                    dir('Library-management/Back-End') {
                        bat """
                        echo "Building backend Docker image..."
                        docker build --no-cache -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} .
                        echo "✅ Backend image built: ${IMAGE_NAME_BACK}:${IMAGE_TAG}"
                        """
                    }

                    // Build de l'image frontend
                    dir('Library-management/Front-End') {
                        bat """
                        echo "Building frontend Docker image..."
                        docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} .
                        echo "✅ Frontend image built: ${IMAGE_NAME_FRONT}:${IMAGE_TAG}"
                        """
                    }

                    // Vérification des images construites
                    bat """
                    echo "📋 Liste des images Docker construites:"
                    docker images | findstr "library" || echo "Aucune image library trouvée"
                    """
                }
            }
            post {
                failure {
                    echo "❌ Échec de la construction des images Docker"
                }
            }
        }

        /******************************************************************
         * 3. PUBLICATION SUR DOCKER HUB
         *****************************************************************/
        stage('☁️ Push to Docker Hub') {
            steps {
                script {
                    echo "🔧 Étape 3: Publication sur Docker Hub"

                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        bat """
                        echo "🔐 Authentification à Docker Hub..."
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin

                        echo "📤 Pushing backend image..."
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}

                        echo "📤 Pushing frontend image..."
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}

                        echo "🚪 Logout from Docker Hub..."
                        docker logout

                        echo "✅ Images publiées avec succès"
                        """
                    }
                }
            }
            post {
                success {
                    echo "✅ Images Docker publiées sur Docker Hub"
                    echo "Backend: ${IMAGE_NAME_BACK}:${IMAGE_TAG}"
                    echo "Frontend: ${IMAGE_NAME_FRONT}:${IMAGE_TAG}"
                }
                failure {
                    echo "❌ Échec de la publication sur Docker Hub"
                }
            }
        }

        /******************************************************************
         * 4. TESTS D'INTÉGRATION
         *****************************************************************/
        stage('🧪 Integration Tests') {
            steps {
                script {
                    echo "🔧 Étape 4: Tests d'intégration des containers"

                    // Nettoyage des containers existants
                    bat """
                    echo "🧹 Nettoyage des containers existants..."
                    docker stop test-backend test-frontend 2>nul || echo "Aucun container à arrêter"
                    docker rm test-backend test-frontend 2>nul || echo "Aucun container à supprimer"
                    """

                    // Démarrage des containers de test
                    bat """
                    echo "🚀 Démarrage des containers de test..."
                    echo "Backend: port ${BACKEND_TEST_PORT}"
                    docker run -d -p ${BACKEND_TEST_PORT}:9090 --name test-backend ${IMAGE_NAME_BACK}:${IMAGE_TAG}

                    echo "Frontend: port ${FRONTEND_TEST_PORT}"
                    docker run -d -p ${FRONTEND_TEST_PORT}:80 --name test-frontend ${IMAGE_NAME_FRONT}:${IMAGE_TAG}

                    echo "⏳ Attente du démarrage des services..."
                    timeout /t 30
                    """

                    // Diagnostic des containers
                    bat """
                    echo "📊 État des containers:"
                    docker ps -a

                    echo "📝 Logs du backend:"
                    docker logs test-backend || echo "Impossible de récupérer les logs du backend"

                    echo "📝 Logs du frontend:"
                    docker logs test-frontend || echo "Impossible de récupérer les logs du frontend"
                    """

                    // Tests de santé
                    bat """
                    echo "🔍 Tests de santé des services..."
                    echo "Testing backend health..."
                    curl -f --retry 3 --retry-delay 5 http://localhost:${BACKEND_TEST_PORT}/actuator/health || echo "❌ Backend health check failed"

                    echo "Testing frontend accessibility..."
                    curl -f http://localhost:${FRONTEND_TEST_PORT}/ || echo "❌ Frontend check failed"

                    echo "✅ Tests d'intégration terminés"
                    """
                }
            }
            post {
                always {
                    echo "📋 Résumé des tests d'intégration"
                }
                failure {
                    echo "❌ Les tests d'intégration ont échoué"
                }
            }
        }

        /******************************************************************
         * 5. NETTOYAGE ENVIRONNEMENT DE TEST
         *****************************************************************/
        stage('🧹 Cleanup Test Environment') {
            steps {
                script {
                    echo "🔧 Étape 5: Nettoyage de l'environnement de test"

                    bat """
                    echo "🧹 Arrêt et suppression des containers de test..."
                    docker stop test-backend test-frontend 2>nul || echo "Aucun container à arrêter"
                    docker rm test-backend test-frontend 2>nul || echo "Aucun container à supprimer"

                    echo "🗑️ Nettoyage des images intermédiaires..."
                    docker image prune -f 2>nul || echo "Aucune image à nettoyer"

                    echo "✅ Environnement de test nettoyé"
                    """
                }
            }
        }
    }

    /******************************************************************
     * POST-BUILD ACTIONS
     *****************************************************************/
    post {
        always {
            echo "🏁 Pipeline terminé: ${currentBuild.currentResult}"
            echo "🔗 URL du build: ${env.BUILD_URL}"
            echo "⏰ Durée: ${currentBuild.durationString}"
        }
        success {
            echo "🎉 SUCCÈS! Pipeline CI/CD opérationnel!"
            echo "📦 Images Docker publiées:"
            echo "   - ${IMAGE_NAME_BACK}:${IMAGE_TAG}"
            echo "   - ${IMAGE_NAME_FRONT}:${IMAGE_TAG}"
            echo "🌐 URLs de test:"
            echo "   - Backend: http://localhost:${BACKEND_TEST_PORT}"
            echo "   - Frontend: http://localhost:${FRONTEND_TEST_PORT}"
        }
        failure {
            echo "💥 Échec du pipeline - Consultez les logs pour plus de détails"
            emailext (
                subject: "❌ Échec du Pipeline: ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                body: """
                Le pipeline ${env.JOB_NAME} a échoué.

                Détails:
                - Build: #${env.BUILD_NUMBER}
                - URL: ${env.BUILD_URL}
                - Cause: Consultez les logs Jenkins
                """,
                to: "dev-team@company.com"
            )
        }
        unstable {
            echo "⚠️ Pipeline instable - Tests échoués"
        }
        aborted {
            echo "⏹️ Pipeline annulé manuellement"
        }
    }
}