pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        APP_NAME_BACK = "library-backend"
        APP_NAME_FRONT = "library-frontend"
        IMAGE_TAG = "v1"
        SONAR_ORGANIZATION = "panoramac"
        SONAR_PROJECT_KEY = "panoramac_LibraryManagement_ProjetDevops"
    }

    stages {
        /********************* 🔍 1. ANALYSE SONARCLOUD *********************/
        stage('SonarCloud Analysis') {
            steps {
                dir('Library-management/Back-End') {
                    script {
                        withSonarQubeEnv('SonarCloud') {
                            withCredentials([string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')]) {
                                bat """
                                echo "🚀 Démarrage analyse SonarCloud..."
                                mvn verify sonar:sonar \
                                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                    -Dsonar.organization=${SONAR_ORGANIZATION} \
                                    -Dsonar.host.url=https://sonarcloud.io \
                                    -Dsonar.login=${SONAR_TOKEN}
                                """
                            }
                        }
                    }
                }
            }
        }

        /********************* ⏳ 2. QUALITY GATE *********************/
        stage("Quality Gate") {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /********************* 🧱 3. BUILD & TESTS *********************/
        stage('Build & Unit Tests') {
            steps {
                git branch: 'develop',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo '✅ Build Maven réussi'
                }
            }
        }

        /********************* 🐳 4. DOCKER BUILD & PUSH *********************/
        stage('Docker Build & Push') {
            steps {
                script {
                    // Build des images
                    dir('Library-management/Back-End') {
                        bat "docker build -t ${APP_NAME_BACK}:${IMAGE_TAG} ."
                    }
                    dir('Library-management/Front-End') {
                        bat "docker build -t ${APP_NAME_FRONT}:${IMAGE_TAG} ."
                    }

                    // Push vers Docker Hub
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        bat """
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker tag ${APP_NAME_BACK}:${IMAGE_TAG} %DOCKER_USER%/${APP_NAME_BACK}:${IMAGE_TAG}
                        docker tag ${APP_NAME_FRONT}:${IMAGE_TAG} %DOCKER_USER%/${APP_NAME_FRONT}:${IMAGE_TAG}
                        docker push %DOCKER_USER%/${APP_NAME_BACK}:${IMAGE_TAG}
                        docker push %DOCKER_USER%/${APP_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        echo "✅ Images Docker Hub poussées!"
                        """

                        // Stocker le nom d'utilisateur Docker pour l'affichage final
                        env.DOCKERHUB_USERNAME = DOCKER_USER
                    }
                }
            }
        }
    }

    /********************* 🏁 POST-BUILD AVEC LIENS *********************/
    post {
        always {
            echo "=========================================="
            echo "Build finished: ${currentBuild.currentResult}"
            echo "Build URL: ${env.BUILD_URL}"
            echo "=========================================="
        }
        success {
            echo '🎉 SUCCÈS ! Pipeline CI/CD complet réussi !'
            echo ''
            echo '📊 RAPPORTS ET LIENS :'
            echo '=========================================='
            echo "🔍 SONARCLOUD - Analyse qualité du code :"
            echo "   📈 Rapport détaillé : https://sonarcloud.io/project/overview?id=${SONAR_PROJECT_KEY}"
            echo "   📋 Métriques : https://sonarcloud.io/project/metrics?id=${SONAR_PROJECT_KEY}"
            echo "   🐛 Issues : https://sonarcloud.io/project/issues?id=${SONAR_PROJECT_KEY}"
            echo ''
            echo '🐳 DOCKER HUB - Images déployées :'
            echo "   📦 Backend : https://hub.docker.com/r/${env.DOCKERHUB_USERNAME}/${APP_NAME_BACK}"
            echo "   📦 Frontend : https://hub.docker.com/r/${env.DOCKERHUB_USERNAME}/${APP_NAME_FRONT}"
            echo "   🏷️  Tag : ${IMAGE_TAG}"
            echo ''
            echo '📋 TESTS UNITAIRES :'
            echo "   📊 Rapports JUnit disponibles dans Jenkins"
            echo "   📁 Artifacts : Fichiers JAR archivés"
            echo ''
            echo '🔗 LIENS RAPIDES :'
            echo "   🌐 GitHub : https://github.com/panoramac/LibraryManagement_ProjetDevops"
            echo "   🏗️  Jenkins : ${env.BUILD_URL}"
            echo '=========================================='
        }
        failure {
            echo '💥 Échec du pipeline. Consultez les logs pour plus de détails.'
            echo '🔍 Zones à vérifier :'
            echo '   - Les logs SonarCloud'
            echo '   - Les résultats des tests Maven'
            echo '   - Les logs Docker'
            echo '   - La configuration des credentials Jenkins'
        }
        unstable {
            echo '⚠️ Build unstable - Qualité du code insuffisante'
            echo "📊 Consultez le rapport SonarCloud : https://sonarcloud.io/project/overview?id=${SONAR_PROJECT_KEY}"
            echo '🔧 Actions recommandées :'
            echo '   - Corriger les bugs critiques'
            '   - Améliorer la couverture de tests'
            echo '   - Réduire la dette technique'
        }
    }
}