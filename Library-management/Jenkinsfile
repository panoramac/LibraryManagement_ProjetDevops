pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {
        /********************* 🧱 1. BUILD MAVEN *********************/
        stage('Build Project') {
            steps {
                git branch: 'feature/docker',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo 'Build Maven successful'
                }
            }
        }

        /********************* 🐳 2. BUILD DES IMAGES DOCKER *********************/
        stage('Build Docker Images') {
                    steps {
                        script {


                         // Build backend
                            dir('Library-management/Back-End') {
                                bat """
                                echo "Building backend image..."
                                docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} .
                                echo "Backend image built successfully"
                                """
                            }

                            // Build frontend
                            dir('Library-management/Front-End') {
                                bat """
                                echo "Building frontend image..."
                                docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} .
                                echo "Frontend image built successfully"
                                """
                            }

                            // Lister les images construites
                            bat 'docker images | findstr "library" || echo "Aucune image library trouvée"'
                        }
            }
        }

        /********************* ☁️ 3. PUSH VERS DOCKER HUB *********************/
        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        echo "Images pushed to Docker Hub"
                        """
                    }
                }
            }
        }


        /********************* 🧪 4. TEST DES CONTAINERS *********************/
        stage('Run Containers for Test') {
            steps {
                script {
                    // Nettoyage
                    bat '''
                    docker stop test-backend test-frontend 2>nul || echo No containers to stop
                    docker rm test-backend test-frontend 2>nul || echo No containers to remove
                    '''

                    // Démarrer les containers
                    bat """
                    docker run -d -p 9091:9090 --name test-backend ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                    docker run -d -p 8080:80 --name test-frontend ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                    timeout /t 30
                    """

                    // Tests
                    bat """
                    echo "Containers status:"
                    docker ps
                    echo "Backend logs:"
                    docker logs test-backend
                    curl -f http://localhost:9091/actuator/health || echo "Backend health check failed"
                    curl -f http://localhost:8080/ || echo "Frontend check failed"
                    """
                }
            }
        }

        /********************* 🧹 5. NETTOYAGE (Optionnel) *********************/
        stage('Cleanup') {
            steps {
                script {
                    bat '''
                    echo "Cleaning up test containers..."
                    docker stop test-backend test-frontend 2>nul || echo "No containers to stop"
                    docker rm test-backend test-frontend 2>nul || echo "No containers to remove"
                    echo "Cleanup completed"
                    '''
                }
            }
        }