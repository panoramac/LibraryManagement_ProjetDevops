pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {

        /********************* 🧱 1. BUILD MAVEN *********************/
        stage('Build Project') {
            steps {
                git branch: 'feature/docker',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'

                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package -Dproject.build.sourceEncoding=ISO-8859-1'
                }
            }
            post {
                success {
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                    echo 'Build Maven successful'
                }
            }
        }

        /********************* 🐳 2. BUILD DES IMAGES DOCKER *********************/
        stage('Build Docker Images') {
            steps {
                script {
                    dir('Library-management/Back-End') {
                        bat """
                        echo "Building backend image..."
                        docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} .
                        """
                    }
                    dir('Library-management/Front-End') {
                        bat """
                        echo "Building frontend image..."
                        docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} .
                        """
                    }
                    bat 'docker images | findstr "library"'
                }
            }
        }

        /********************* ☁️ 3. PUSH VERS DOCKER HUB *********************/
        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        """
                    }
                }
            }
        }

        /********************* 🧩 4. DEPLOY SUR KUBERNETES *********************/
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    steps {
                            echo 'Applying Kubernetes manifests...'
                            bat 'kubectl apply -f deployment.yaml'
                            bat 'kubectl apply -f service.yaml'
                            bat 'kubectl apply -f ingress.yaml'
                        }
                    echo "Waiting for pods to be ready..."
                    bat 'kubectl rollout status deployment/backend-deployment'
                    bat 'kubectl rollout status deployment/frontend-deployment'
                }
            }
        }

        /********************* 🌐 5. TEST ACCÈS VIA INGRESS *********************/
        stage('Verify Ingress Access') {
            steps {
                script {
                    echo "Testing application access via Ingress..."
                    // Récupère l’IP de Minikube
                    bat """
                    for /f "tokens=* USEBACKQ" %%i in (`minikube ip`) do set MINIKUBE_IP=%%i
                    echo "Minikube IP is %MINIKUBE_IP%"
                    curl -f http://%MINIKUBE_IP%/ || (echo "❌ Frontend unreachable" & exit /b 1)
                    """
                }
            }
        }
    }

    /********************* 🏁 POST-BUILD *********************/
    post {
        always {
            echo "Build finished: ${currentBuild.currentResult}"
        }
        success {
            echo '✅ SUCCESS! CI/CD + Kubernetes deployment working perfectly!'
        }
        failure {
            echo '❌ Pipeline failed. Check Jenkins logs.'
        }
    }
}
