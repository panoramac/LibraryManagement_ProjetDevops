pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        IMAGE_NAME_BACK = "elkarkafidouaa/library-backend"
        IMAGE_NAME_FRONT = "elkarkafidouaa/library-frontend"
        IMAGE_TAG = "v1"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'feature/pipeline-jenkins',
                    url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'
            }
        }

        stage('Build Backend with Maven') {
            steps {
                dir('Library-management/Back-End') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Archive Backend Jar') {
            steps {
                archiveArtifacts artifacts: 'Library-management/Back-End/**/target/*.jar', followSymlinks: false
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    bat """
                    docker build -t ${IMAGE_NAME_BACK}:${IMAGE_TAG} -f Library-management/Back-End/Dockerfile .
                    docker build -t ${IMAGE_NAME_FRONT}:${IMAGE_TAG} -f Library-management/Front-End/Dockerfile .
                    """
                }
            }
        }

        stage('Push Docker Images to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        bat """
                        echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                        docker push ${IMAGE_NAME_BACK}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME_FRONT}:${IMAGE_TAG}
                        docker logout
                        """
                    }
                }
            }
        }

        stage('Test with docker-compose') {
            steps {
                script {
                    bat """
                    docker compose -f Library-management/docker-compose.yml up -d
                    timeout /t 10
                    docker ps
                    docker compose -f Library-management/docker-compose.yml down
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline réussi ! Images ${IMAGE_TAG} publiées sur Docker Hub."
        }
        failure {
            echo "❌ Le pipeline a échoué, consultez les logs Jenkins."
        }
    }
}
