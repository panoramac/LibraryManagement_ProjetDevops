pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'feature/pipeline-jenkins',
                url: 'https://github.com/panoramac/LibraryManagement_ProjetDevops.git'
            }
        }

        stage('Build Back-End') {
            steps {
                // 🎯 CHEMIN CORRECT : Library-management/Back-End
                dir('Library-management/Back-End') {
                    bat 'mvn clean compile test package'
                }
            }
            post {
                success {
                    // 🎯 Chemins corrigés pour l'archivage
                    archiveArtifacts 'Library-management/Back-End/**/target/*.war'
                    archiveArtifacts 'Library-management/Back-End/**/target/*.jar'
                    junit 'Library-management/Back-End/**/target/surefire-reports/*.xml'
                }
            }
        }
    }

    post {
        always {
            echo "Build ${currentBuild.currentResult} - Voir: ${env.BUILD_URL}"
        }
        success {
            echo '✅ ✅✅ BUILD RÉUSSI ! Pipeline fonctionne ! ✅✅✅'
            echo '🎉 Félicitations ! Votre pipeline CI/CD est opérationnel !'
        }
        failure {
            echo '❌ Build échoué - Vérifiez les logs ci-dessus'
        }
    }
}